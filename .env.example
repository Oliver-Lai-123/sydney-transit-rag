# Copy to .env and fill in. Never commit .env.
# Use letters and numbers only in passwords: characters such as @ : / # % ?
# break the connection URLs below.

# --- Database (docker compose reads these) ---
POSTGRES_DB=transit
POSTGRES_USER=transit_admin
POSTGRES_PASSWORD=change-me-admin
# 5433 rather than the default 5432, so it does not clash with a PostgreSQL
# installed directly on your computer
POSTGRES_PORT=5433

# Read-only role used by the text-to-SQL path and the eval validator
READONLY_PASSWORD=change-me-readonly

# --- Connection strings used by the Python scripts ---
# The passwords and port here must match the values above.
# 127.0.0.1 rather than localhost: on Windows, localhost can resolve to IPv6
# and reach a different process than the Docker database.
# Admin: loading data, creating indexes
DATABASE_URL=postgresql://transit_admin:change-me-admin@127.0.0.1:5433/transit
# Read-only: anything that executes LLM-generated or eval SQL
READONLY_DATABASE_URL=postgresql://transit_reader:change-me-readonly@127.0.0.1:5433/transit

# --- TfNSW Open Data Hub ---
# Register at https://opendata.transport.nsw.gov.au and create an API key
# with access to "Public Transport - Timetables - Complete - GTFS"
TFNSW_API_KEY=
